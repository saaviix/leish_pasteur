                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A word or short phrase that identifies a document as a member of a user-defined collection. Used to organize documents in a file browser.</pdfaProperty:description>
